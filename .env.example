# Backend Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3002

# Frontend Configuration
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Event authentication (USAR FOSS OIDC)
OIDC_ISSUER=https://oidc.fossclub.tech
# OIDC_DISCOVERY_URL=  # Optional override for non-standard discovery locations
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=  # Optional for public PKCE clients
# OIDC_CLIENT_AUTH_METHOD=client_secret_basic  # Or client_secret_post
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
OIDC_POST_LOGIN_URL=http://localhost:3002/event
OIDC_SCOPES=openid profile email club
OIDC_DISPLAY_NAME_CLAIM=name
OIDC_PICTURE_CLAIM=picture
OIDC_GITHUB_USERNAME_CLAIM=preferred_username
OIDC_ADMIN_SUBJECTS=
OIDC_SESSION_SECRET=
OIDC_SESSION_SECONDS=28800
# OIDC_COOKIE_DOMAIN=.example.com  # Set parent domain if frontend/API are sibling subdomains

# Neon PostgreSQL event persistence. Use Neon’s pooled connection string in production.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
