# Backend Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3002

# Frontend Configuration
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Event authentication (USAR FOSS OIDC)
OIDC_ISSUER=https://oidc.fossclub.tech
# OIDC_DISCOVERY_URL=  # Optional override for non-standard discovery locations
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=  # Optional for public PKCE clients
# OIDC_CLIENT_AUTH_METHOD=client_secret_basic  # Or client_secret_post
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
OIDC_POST_LOGIN_URL=http://localhost:3002/event
OIDC_SCOPES=openid profile email club
OIDC_DISPLAY_NAME_CLAIM=name
OIDC_PICTURE_CLAIM=picture
OIDC_GITHUB_USERNAME_CLAIM=preferred_username
OIDC_ADMIN_SUBJECTS=
OIDC_SESSION_SECRET=
OIDC_SESSION_SECONDS=28800
# OIDC_COOKIE_DOMAIN=.example.com  # Set parent domain if frontend/API are sibling subdomains

# Neon PostgreSQL event persistence. Use Neon’s pooled connection string in production.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Redis (Upstash). When both are set the server keeps rooms in Redis (a restart or redeploy mid-game comes back where it was) and the
# leaderboard lives there. Leave them empty to run entirely in memory. Set STATE_BACKEND=memory to ignore them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# STATE_BACKEND=memory
# Give each deployment that shares a Redis its own prefix (default quiktype:v1:)
# REDIS_KEY_PREFIX=quiktype:v1:

# Browser origins allowed to connect, besides FRONTEND_URL (comma separated hostnames; * matches within a label)
# ALLOWED_ORIGIN_PATTERNS=quik-type*.vercel.app
# Allow http://localhost:* origins even in production
# ALLOW_LOCALHOST_ORIGINS=true

# How many reverse proxies sit in front of the server (the platform's counts as one). Used to find the player's address for abuse limits.
# TRUST_PROXY_HOPS=1

# Enables the organizer routes (loading the team list, excusing or disqualifying a team, GET /debug/rooms) for requests sending
# "Authorization: Bearer <token>". Use a long random value. Unset: those routes do not exist.
# ADMIN_TOKEN=

